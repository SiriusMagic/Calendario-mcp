<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Modo MCP through the relay, only when the user turns it on (off by default). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- «Recordatorio»: a notification at the exact minute, also in Doze and after a restart. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- «Redireccionar a Hub»: only apps signed with the same key (Gateway Hub) get this permission. -->
    <permission android:name="com.zirakusa.gatewayhub.permission.LINK" android:protectionLevel="signature"
        android:label="@string/hub_link_permission" />
    <!-- The family summary («Hoy» in Inicio): only apps signed with the same key may read it. -->
    <permission android:name="com.zirakusa.family.permission.SUMMARY" android:protectionLevel="signature"
        android:label="@string/summary_permission" />
    <!-- «Ir al Hub» opens the Gateway Hub app, when it is installed. -->
    <queries><package android:name="com.zirakusa.gatewayhub" /></queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Gateway Hub's scanner finds the calendar (module calendar_) and its link channel. Being found turns nothing on. -->
            <intent-filter>
                <action android:name="com.zirakusa.gatewayhub.action.APP" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data android:name="com.zirakusa.gatewayhub.module" android:value="calendar_" />
            <meta-data android:name="com.zirakusa.gatewayhub.link" android:value="${applicationId}.hublink" />
            <meta-data android:name="com.zirakusa.family.summary" android:value="${applicationId}.summary" />
        </activity>
        <receiver android:name=".ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>
        <provider android:name=".SummaryProvider" android:authorities="${applicationId}.summary"
            android:exported="true" android:permission="com.zirakusa.family.permission.SUMMARY" />
        <provider android:name=".mcp.HubLinkProvider" android:authorities="${applicationId}.hublink"
            android:exported="true" android:permission="com.zirakusa.gatewayhub.permission.LINK" />
    </application>
</manifest>
